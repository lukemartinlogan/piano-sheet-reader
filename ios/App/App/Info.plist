<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Sheet Reader</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The app never reaches the network, so it is exempt from the export
	     compliance question every upload otherwise asks. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The whole app is dark; letting iOS decide leaves light form controls
	     and a black-on-black status bar on a light-mode iPad. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Scores arrive from Files, AirDrop, Mail and Split View drag-and-drop.
	     Deliberately *not* opening in place: an in-place URL is security-scoped
	     and lives outside the sandbox, which the file bridge cannot read without
	     a scope claim. iOS instead drops a copy in Documents/Inbox, which is
	     readable, and the app files that copy into its library and deletes it. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- The app's own Documents folder is visible in the Files app, so the
	     library is a real folder the user can add to and back up. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UISupportsDocumentBrowser</key>
	<false/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MusicXML Score</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.recordare.musicxml</string>
				<string>com.recordare.musicxml.compressed</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MIDI File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.midi-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Score</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<!-- Alternate, not Owner: the app reads engraved PDFs, it is not a
			     PDF viewer, and it should never displace Books or Files. -->
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>

	<!-- MusicXML has no system UTI. These are *imported* declarations: they
	     teach this app the type without claiming ownership of it, which is also
	     what makes the in-app file picker offer .musicxml and .mxl files
	     instead of greying them out as unknown. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.recordare.musicxml</string>
			<key>UTTypeDescription</key>
			<string>MusicXML Score</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>musicxml</string>
					<string>xml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.recordare.musicxml+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.recordare.musicxml.compressed</string>
			<key>UTTypeDescription</key>
			<string>Compressed MusicXML Score</string>
			<!-- An .mxl is a zip container, and saying so is what lets Files and
			     Mail hand one over rather than treating it as opaque data. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.pkware.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mxl</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.recordare.musicxml</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Landscape is how music is read, but a stand-mounted iPad can be either
	     way up, so all four are allowed and the layout adapts. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
