{
  "name": "piano-sheet-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "smoke": "tsx scripts/smoke.ts",
    "midi": "tsx scripts/midi-smoke.ts",
    "pdf": "tsx scripts/pdf-smoke.ts",
    "verify": "node scripts/verify-render.mjs",
    "ios": "npm run build && cap sync ios && node scripts/fix-spm-paths.mjs",
    "ios:open": "cap open ios",
    "app-art": "node scripts/make-app-art.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "jszip": "^3.10.1",
    "opensheetmusicdisplay": "^1.9.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
